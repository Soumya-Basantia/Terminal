{
  "name": "terminal-server",
  "version": "1.0.0",
  "description": "TERMINAL — Campus Game Platform API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "node scripts/generate-client.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node src/prisma/seed-loader.js",
    "seed:codenex-gm": "node src/prisma/seed-codenex-gm-loader.js"
  },
  "keywords": [],
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.4",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}

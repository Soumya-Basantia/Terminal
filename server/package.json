{
  "name": "terminal-server",
  "version": "1.0.0",
  "description": "TERMINAL — Campus Game Platform API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma && node -e \"require('fs').cpSync('../node_modules/@prisma/client', './node_modules/@prisma/client', {recursive: true}); require('fs').cpSync('../node_modules/.prisma', './node_modules/.prisma', {recursive: true})\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node src/prisma/seed-loader.js"
  },
  "keywords": [],
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
